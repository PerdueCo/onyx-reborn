DATABASE_URL=sqlite:///./onyx.db

# ── Required secrets — app will not start without these ──────────────────────
# Generate SESSION_SECRET with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Generate MFA_ENC_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Both reset_db.py and the running server MUST use the same key.
# If they differ, TOTP verify will always fail ("That code didn't work").
MFA_ENC_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
ENV=dev
DEMO_MODE=true
PORTAL_ENABLED=true
